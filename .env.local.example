# Admin panel password — choose anything you like
ADMIN_PASSWORD=your-chosen-password

# Random 32+ character string for signing session cookies
# Generate one: openssl rand -base64 32
ADMIN_SECRET=replace-with-random-32-char-string

# GitHub token with repo scope (run: gh auth token)
GITHUB_TOKEN=ghp_...

# Your GitHub username and repo name
GITHUB_OWNER=erickmclark
GITHUB_REPO=portfolio

# Canonical site URL (production domain). Used for metadata, sitemap, robots, OG.
NEXT_PUBLIC_SITE_URL=https://clarkport.vercel.app

# Upstash Redis (Vercel Marketplace "KV") — content store.
# Auto-injected by the Vercel integration; for local dev run `vercel env pull`.
KV_REST_API_URL=
KV_REST_API_TOKEN=
